{
  "manifest_version": 3,
  "name": "Pacer",
  "version": "1.0.0",
  "description": "Fills in job applications with your tailored resume, cover letter and saved answers from the Pacer app on this computer.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pacer: fill in this application"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
